{
  "name": "self-evolving-workflow",
  "version": "0.6.0",
  "description": "Self-Evolving Workflow with a local code graph, a Markdown wiki, and agent memory search",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/catlog22/self-evolving-workflow.git"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "bin": {
    "evolve": "dist/workflow-cli.js"
  },
  "omp": {
    "extensions": ["./dist/omp-extension.js"]
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./code": {
      "types": "./dist/code.d.ts",
      "default": "./dist/code.js"
    },
    "./wiki": {
      "types": "./dist/wiki.d.ts",
      "default": "./dist/wiki.js"
    },
    "./memory": {
      "types": "./dist/memory.d.ts",
      "default": "./dist/memory.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "default": "./dist/http.js"
    },
    "./orchestrator": {
      "types": "./dist/orchestrator.d.ts",
      "default": "./dist/orchestrator.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "agents",
    "rules",
    "assets",
    "workflows",
    "docs/images",
    ".claude-plugin",
    ".codex-plugin",
    ".antigravity-plugin",
    ".agents/plugins",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node --input-type=module -e \"import {rmSync} from 'node:fs'; for (const f of ['cli.js','cli.d.ts','workflow-mcp.js','workflow-mcp.d.ts']) rmSync('dist/'+f,{force:true})\"",
    "setup": "npm run build && npm link && node dist/workflow-cli.js skill install",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:codex-replay": "npm run build && node test/codex-replay.mjs",
    "test:codex-replay-contract": "npm run build && node test/codex-replay-contract.mjs",
    "test:codex-evolve": "npm run build && node test/codex-evolve-native.mjs",
    "test:legacy-codex-evolve": "npm run build && node test/maestro-closeout.mjs --codex-evolve",
    "test:legacy-codex-standalone": "npm run build && node test/codex-standalone.mjs",
    "test:codex-workflow": "npm run build && node test/codex-workflow.mjs",
    "test:codex-chain": "npm run build && node test/codex-workflow.mjs chain",
    "test:codex-campaigns": "npm run build && node test/codex-workflow.mjs odyssey swarm",
    "test:legacy-codex-chain": "node test/codex-chain.mjs",
    "test:legacy-codex-campaigns": "node test/codex-campaigns.mjs",
    "test:release-gate-flow": "npm run build && node test/release-gate-flow.mjs",
    "test:ew-layout": "node test/ew-layout.mjs",
    "test:legacy-closeout": "npm run build && node test/maestro-closeout.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@colbymchenry/codegraph": "1.6.4",
    "@node-rs/jieba": "2.0.1",
    "@types/emscripten": "^1.41.6",
    "graphology": "0.26.0",
    "ignore": "^7.0.5",
    "web-tree-sitter": "^0.25.3",
    "yaml": "2.8.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.9.3"
  }
}
